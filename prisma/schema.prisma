generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceStatus {
  PENDING
  PROVISIONING
  RUNNING
  IDLE
  STOPPED
  FAILED
  DELETED
}

enum UserRole {
  USER
  ADMIN
}

enum RuntimeContainerType {
  IDE
  CKB_NODE
  FIBER_RUNTIME
  PREVIEW
  TEST_RUNNER
}

enum RuntimeContainerStatus {
  CREATED
  STARTING
  RUNNING
  STOPPED
  FAILED
}

enum AuthProvider {
  EMAIL
  CKB_WALLET
}

model User {
  id String @id @default(uuid())

  name         String
  email        String? @unique
  passwordHash String?

  walletAddress String?      @unique
  authProvider  AuthProvider @default(EMAIL)

  role UserRole @default(USER)

  workspaces       Workspace[]
  walletChallenges WalletChallenge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([walletAddress])
}

model WalletChallenge {
  id String @id @default(uuid())

  walletAddress String
  nonce         String @unique
  message       String

  expiresAt DateTime
  usedAt    DateTime?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([walletAddress])
  @@index([expiresAt])
}

model Workspace {
  id     String          @id @default(uuid())
  name   String
  status WorkspaceStatus @default(PENDING)

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  templateId String?

  runtimeNetwork String?
  runtimeVolume  String?
  ckbDataVolume  String?

  lastStartedAt DateTime?
  lastStoppedAt DateTime?

  containers WorkspaceContainer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model WorkspaceContainer {
  id String @id @default(uuid())

  workspaceId String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  containerId String @unique
  name        String
  image       String

  type RuntimeContainerType

  status RuntimeContainerStatus @default(CREATED)

  internalPort Int?
  hostPort     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, type])
  @@index([workspaceId])
  @@index([containerId])
  @@index([status])
  @@index([type])
}
