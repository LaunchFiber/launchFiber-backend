generator client {
    provider     = "prisma-client"
    output       = "../src/generated/prisma"
    moduleFormat = "cjs"
}

datasource db {
    provider = "postgresql"
}

enum WorkspaceStatus {
    PENDING
    PROVISIONING
    RUNNING
    IDLE
    STOPPED
    FAILED
    DELETED
}

enum UserRole {
    USER
    ADMIN
}

enum RuntimeContainerType {
    IDE
    FIBER_RUNTIME
    PREVIEW
    TEST_RUNNER
}

enum RuntimeContainerStatus {
    CREATED
    RUNNING
    STOPPED
    FAILED
}

model User {
    id           String   @id @default(uuid())
    name         String
    email        String   @unique
    passwordHash String
    role         UserRole @default(USER)
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    // Relation
    workspaces Workspace[]
}

model Workspace {
    id     String          @id @default(uuid())
    name   String
    status WorkspaceStatus @default(PENDING)

    // Relation
    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    templateId String?

    runtimeNetwork String?
    runtimeVolume  String?

    lastStartedAt DateTime?
    lastStoppedAt DateTime?

    containers WorkspaceContainer[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([userId])
}

model WorkspaceContainer {
    id          String    @id @default(uuid())
    workspaceId String
    workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

    containerId String                 @unique
    name        String
    type        RuntimeContainerType
    image       String
    status      RuntimeContainerStatus @default(CREATED)

    internalPort Int?
    hostPort     Int?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([workspaceId, type])
    @@index([workspaceId])
}
